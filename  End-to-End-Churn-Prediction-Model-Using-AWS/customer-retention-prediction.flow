.days"}, "pyspark_parameters": {}, "name": "customer tenure in days"}, "inputs": [{"name": "df", "node_id": "9dc49d71-b9f3-47d4-88b1-be21fb26e4f3", "output_name": "default"}], "outputs": [{"name": "default"}]}, {"node_id": "d46bfbff-4d63-49f9-9cde-20e1834aba8a", "type": "TRANSFORM", "operator": "sagemaker.spark.custom_code_0.1", "parameters": {"operator": "Python (Pandas)", "pandas_parameters": {"code": "import pandas as pd\n\ndf['lastorder'] = pd.to_datetime(df['lastorder'])\n\ntoday = pd.Timestamp.today()\n\ndf['recency_days'] = (today - df['lastorder']).dt.days\n"}, "pyspark_parameters": {}, "name": "Recent Order days"}, "inputs": [{"name": "df", "node_id": "4bd27a96-7ecd-4e83-9747-379c100e9d6b", "output_name": "default"}], "outputs": [{"name": "default"}]}, {"node_id": "d0874e18-759e-43b6-8cc8-110d31409464", "type": "TRANSFORM", "operator": "sagemaker.spark.custom_code_0.1", "parameters": {"operator": "Python (Pandas)", "pandas_parameters": {"code": "import pandas as pd\n\ndf['firstorder'] = pd.to_datetime(df['firstorder'])\ndf['created'] = pd.to_datetime(df['created'])\n\ndf['first_order_delay'] = (df['firstorder'] - df['created']).dt.days"}, "pyspark_parameters": {"code": "import pandas as pd \n\ndf['firstorder'] = pd.to_datetime(df['firstorder'])\ndf['created'] = pd.to_datetime(df['created'])\n\ndf['first_order_delay'] = (df['firstorder'] - df['created']).dt.days\n"}, "name": "Days to First Purchase"}, "inputs": [{"name": "df", "node_id": "d46bfbff-4d63-49f9-9cde-20e1834aba8a", "output_name": "default"}], "outputs": [{"name": "default"}]}, {"node_id": "a27a8697-1633-4c33-9d73-5f6364774348", "type": "TRANSFORM", "operator": "sagemaker.spark.custom_code_0.1", "parameters": {"operator": "Python (Pandas)", "pandas_parameters": {"code": "df['email_engagement_score'] = df['eopenrate'] + df['eclickrate']"}, "pyspark_parameters": {}, "name": "Email Engagement Score"}, "inputs": [{"name": "df", "node_id": "d0874e18-759e-43b6-8cc8-110d31409464", "output_name": "default